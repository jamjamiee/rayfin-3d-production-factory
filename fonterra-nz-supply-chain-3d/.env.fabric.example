# Copy to .env.fabric.local (ignored by Git) and fill in your deployment values.
# VITE_* values are embedded in the public frontend bundle. Never put secrets here.
# The workspace/item/model IDs must be GUIDs for the same deployed app and model.
VITE_RAYFIN_API_URL=
VITE_RAYFIN_PUBLISHABLE_KEY=
VITE_RAYFIN_ITEM_ID=
VITE_RAYFIN_WORKSPACE_ID=
VITE_RAYFIN_MODEL_ID=
