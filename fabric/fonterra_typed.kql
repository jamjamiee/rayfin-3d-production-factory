    Longitude=toreal(Payload.Longitude),
    ReportingCurrencyCode=tostring(Payload.ReportingCurrencyCode),
    IsLate=tobool(Payload.IsLate),
    LineNumber=toint(Line.LineNumber),
    ProductKey=tolong(Line.ProductKey),
    ProductCode=tostring(Line.ProductCode),
    ProductName=tostring(Line.ProductName),
    Brand=tostring(Line.Brand),
    BrandScopeId=tostring(Line.BrandScopeId),
    PortfolioStatus=tostring(Line.PortfolioStatus),
    CategoryName=tostring(Line.CategoryName),
    Channel=tostring(Line.Channel),
    MarketCode=tostring(Line.MarketCode),
    PackSize=tostring(Line.PackSize),
    QuantityUnit=tostring(Line.QuantityUnit),
    StorageCondition=tostring(Line.StorageCondition),
    Quantity=tolong(Line.Quantity),
    UnitPrice=todecimal(tostring(Line.UnitPrice)),
    NetPrice=todecimal(tostring(Line.NetPrice)),
    UnitCost=todecimal(tostring(Line.UnitCost)),
    DiscountPercent=toint(Line.DiscountPercent),
    LineNetAmount=todecimal(tostring(Line.LineNetAmount)),
    LineNetAmountNZD=todecimal(tostring(Line.LineNetAmountNZD)),
    CurrencyCode=tostring(Line.CurrencyCode),
    ExchangeRate=todecimal(tostring(Line.ExchangeRate)),
    BatchId=tostring(Line.BatchId),
    BrandSourceUrls=Line.BrandSourceUrls,
    OrderedQuantityDelta=tolong(Line.OrderedQuantityDelta),
    DispatchedQuantityDelta=tolong(Line.DispatchedQuantityDelta),
    SoldQuantityDelta=tolong(Line.SoldQuantityDelta),
    SalesAmount=todecimal(tostring(Line.SalesAmount)),
    SalesAmountNZD=todecimal(tostring(Line.SalesAmountNZD)),
    RawIngestedAt,
    ProcessedAt=now(),
    DestinationId=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.DestinationId), ""),
    DestinationName=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.DestinationName), ""),
    DestinationType=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.DestinationType), ""),
    DestinationCountryCode=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.DestinationCountryCode), ""),
    DestinationCity=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.DestinationCity), ""),
    DestinationRegion=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.DestinationRegion), ""),
    DestinationLatitude=iff(tostring(Payload.SchemaVersion) == "1.1", toreal(Payload.DestinationLatitude), real(null)),
    DestinationLongitude=iff(tostring(Payload.SchemaVersion) == "1.1", toreal(Payload.DestinationLongitude), real(null)),
    SupermarketChain=iff(tostring(Payload.SchemaVersion) == "1.1", tostring(Payload.SupermarketChain), ""),
    IsNZSupermarketDelivery=iff(tostring(Payload.SchemaVersion) == "1.1", tobool(Payload.IsNZSupermarketDelivery), bool(null)),
    IsDispatchedToNZSupermarket=iff(tostring(Payload.SchemaVersion) == "1.1", tobool(Payload.IsDispatchedToNZSupermarket), bool(null))
}

.create-or-alter function with (folder='Fonterra/Typed', docstring='Fonterra typed schema v1.1') FonterraParseRejected() {
FonterraClassifyRaw()
| where isnotempty(ValidationError)
| project
    RejectionKey=hash_sha256(tostring(Payload)),
    SimulationRunId=toguid(Payload.SimulationRunId),
    EventId=toguid(Payload.EventId),
    EventTime=todatetime(Payload.EventTime),
    ValidationError,
    RawIngestedAt,
    ProcessedAt=now(),
    Payload
}

.create async ifnotexists materialized-view with (backfill=true, autoUpdateSchema=true, folder='Fonterra/Typed', docString='Fonterra typed schema v1.1') FonterraOrderEventsUnique on table FonterraOrderEvents {
FonterraOrderEvents | summarize arg_max(ProcessedAt, *) by SimulationRunId, EventId
}

.create async ifnotexists materialized-view with (backfill=true, autoUpdateSchema=true, folder='Fonterra/Typed', docString='Fonterra typed schema v1.1') FonterraOrderLinesUnique on table FonterraOrderLines {
FonterraOrderLines | summarize arg_max(ProcessedAt, *) by SimulationRunId, EventId, LineNumber
}

.create async ifnotexists materialized-view with (backfill=true, autoUpdateSchema=true, folder='Fonterra/Typed', docString='Fonterra typed schema v1.1') FonterraOrdersCurrent on table FonterraOrderEvents {
FonterraOrderEvents | summarize arg_max(EventSequence, *) by SimulationRunId, OrderKey
}

.alter table FonterraOrderEvents policy update '[{"IsEnabled":true,"Source":"FonterraSalesRaw","Query":"FonterraParseOrderEvents()","IsTransactional":true,"PropagateIngestionProperties":false}]'

.alter table FonterraOrderLines policy update '[{"IsEnabled":true,"Source":"FonterraSalesRaw","Query":"FonterraParseOrderLines()","IsTransactional":true,"PropagateIngestionProperties":false}]'

.alter table FonterraSalesRejected policy update '[{"IsEnabled":true,"Source":"FonterraSalesRaw","Query":"FonterraParseRejected()","IsTransactional":true,"PropagateIngestionProperties":false}]'

// Backfill only absent immutable keys; concurrent live overlaps are removed by the Unique views.

.set-or-append FonterraOrderEvents <|
FonterraParseOrderEvents()
| summarize arg_max(ProcessedAt, *) by SimulationRunId, EventId
| join kind=leftanti (FonterraOrderEvents | project SimulationRunId, EventId) on SimulationRunId, EventId
| project SchemaVersion, IsSynthetic, CatalogAsOf, SimulationRunId, EventId, EventSequence, EventType, EventTime, ClockMode, OrderKey, OrderNumber, OrderStatus, OrderDate, ExpectedDeliveryDate, DispatchDate, DeliveryDate, DispatchId, CancellationReason, CustomerKey, CustomerName, StoreKey, StoreName, WarehouseId, Brand, BrandScopeId, PortfolioStatus, Channel, MarketCode, Country, City, Latitude, Longitude, CurrencyCode, ReportingCurrencyCode, ExchangeRate, OrderNetAmount, OrderNetAmountNZD, SalesAmount, SalesAmountNZD, OrderCountDelta, TaxIncluded, IsLate, RawIngestedAt, ProcessedAt, DestinationId, DestinationName, DestinationType, DestinationCountryCode, DestinationCity, DestinationRegion, DestinationLatitude, DestinationLongitude, SupermarketChain, IsNZSupermarketDelivery, IsDispatchedToNZSupermarket

.set-or-append FonterraOrderLines <|
FonterraParseOrderLines()
| summarize arg_max(ProcessedAt, *) by SimulationRunId, EventId, LineNumber
| join kind=leftanti (FonterraOrderLines | project SimulationRunId, EventId, LineNumber) on SimulationRunId, EventId, LineNumber
| project SchemaVersion, IsSynthetic, CatalogAsOf, SimulationRunId, EventId, EventSequence, EventType, EventTime, ClockMode, OrderKey, OrderNumber, OrderStatus, OrderDate, ExpectedDeliveryDate, DispatchDate, DeliveryDate, DispatchId, CustomerKey, CustomerName, StoreKey, StoreName, WarehouseId, Country, City, Latitude, Longitude, ReportingCurrencyCode, IsLate, LineNumber, ProductKey, ProductCode, ProductName, Brand, BrandScopeId, PortfolioStatus, CategoryName, Channel, MarketCode, PackSize, QuantityUnit, StorageCondition, Quantity, UnitPrice, NetPrice, UnitCost, DiscountPercent, LineNetAmount, LineNetAmountNZD, CurrencyCode, ExchangeRate, BatchId, BrandSourceUrls, OrderedQuantityDelta, DispatchedQuantityDelta, SoldQuantityDelta, SalesAmount, SalesAmountNZD, RawIngestedAt, ProcessedAt, DestinationId, DestinationName, DestinationType, DestinationCountryCode, DestinationCity, DestinationRegion, DestinationLatitude, DestinationLongitude, SupermarketChain, IsNZSupermarketDelivery, IsDispatchedToNZSupermarket

.set-or-append FonterraSalesRejected <|
FonterraParseRejected()
| summarize arg_max(ProcessedAt, *) by RejectionKey
| join kind=leftanti (FonterraSalesRejected | project RejectionKey) on RejectionKey
| project RejectionKey, SimulationRunId, EventId, EventTime, ValidationError, RawIngestedAt, ProcessedAt, Payload
